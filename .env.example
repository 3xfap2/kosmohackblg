# Копия в .env; сам .env в репозиторий не попадает.
# Бюджет одного запроса расчёта, секунды (лимит Vercel Hobby — 300).
SOZVEZDIE_STEP_BUDGET_S=240
# Секрет подписи записи смены (HMAC): на развёртывании задать свой, иначе используется открытый учебный.
SOZVEZDIE_RECORD_SECRET=
# ИИ-помощник (необязательно). Без ключа работают шаблонные ответы по фактам журнала.
ANTHROPIC_API_KEY=
SOZVEZDIE_AI_MODEL=claude-opus-5
